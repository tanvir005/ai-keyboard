// Secrets for local builds. COMMITTED as an example — copy it, don't edit it:
//
//     cd ios
//     cp Secrets.xcconfig.example Secrets.xcconfig
//     # then paste your key into Secrets.xcconfig and run: xcodegen generate
//
// Secrets.xcconfig itself is gitignored, so your real key never reaches git.
// Leaving these empty is fine: every AI tool stays on the stub.

// Your OpenAI API key, e.g. sk-proj-... — read into the app's Info.plist as
// NibOpenAIKey and used by OpenAIClient. Ships inside the built app; use a
// restricted, low-limit key and rotate it freely.
NIB_OPENAI_KEY =

// Optional. The exact OpenAI model id, e.g. gpt-4o-mini or gpt-4o.
// Leave empty to use the default (gpt-4o-mini).
NIB_OPENAI_MODEL =
